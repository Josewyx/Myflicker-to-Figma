{
  "name": "myflicker-to-figma",
  "version": "0.5.8",
  "description": "让 MyFlicker 用自然语言读写和编辑 Figma 原生设计。免费 Figma 账号也支持，具备文件编辑权限即可使用；支持原生动效，具体能力以当前账号和编辑器为准。生成结果可继续编辑，不消耗官方远程 MCP 调用额度。",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "main": "mf/mcp.mjs",
  "bin": {
    "mf-figma": "mf/cli.mjs"
  },
  "files": [
    "mf",
    "lib/bridge.mjs",
    "lib/capabilities.mjs",
    "lib/catalog.mjs",
    "lib/figma-use-contract.mjs",
    "lib/script-preflight.mjs",
    "lib/assets.mjs",
    "lib/storage.mjs",
    "companion/code.js",
    "companion/manifest.json",
    "skills/myflicker-to-figma",
    "skills/figma-workbench/references",
    ".claude-plugin",
    ".mcp.json",
    "README.md",
    "LICENSE",
    "UPSTREAM.md",
    "setup.mjs",
    "runtime-payload"
  ],
  "scripts": {
    "check": "node scripts/check-mf.mjs",
    "test": "node --test test/mf-local/*.test.mjs",
    "test:upstream": "node --test test/bridge.test.mjs test/runtime.test.mjs test/runtime-queries.test.mjs test/motion-specs.test.mjs test/figma-use-contract.test.mjs test/script-preflight.test.mjs test/page-performance.test.mjs",
    "test:all": "npm run check && npm test && npm run test:upstream",
    "setup": "node mf/cli.mjs setup",
    "install:mf": "node mf/cli.mjs install-mf",
    "release": "node scripts/release-mf.mjs",
    "build:companion": "node scripts/build-companion.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "acorn": "8.15.0",
    "ajv": "8.17.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Josewyx/Myflicker-to-Figma.git"
  },
  "homepage": "https://github.com/Josewyx/Myflicker-to-Figma",
  "bugs": {
    "url": "https://github.com/Josewyx/Myflicker-to-Figma/issues"
  }
}
